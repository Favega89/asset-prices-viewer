# Notion integration token — https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion prices data source ID (UUID only — not the page Copy-link URL)
NOTION_PRICES_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: CoinGecko API key (public API works without it)
# COINGECKO_API_KEY=
